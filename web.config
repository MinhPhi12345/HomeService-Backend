<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk: gỡ WebDAV để các request PUT/DELETE (duyệt Tasker, khóa tài khoản, sửa dịch vụ, xử lý khiếu nại…)
  đi thẳng vào ASP.NET Core. Nếu còn WebDAV, IIS tự trả 405 (không kèm header CORS) và trình duyệt báo "không kết nối được máy chủ".
  dotnet publish sẽ tự điền processPath/arguments/hostingModel vào file này.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\HomeService.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess" />
    </system.webServer>
  </location>
</configuration>
